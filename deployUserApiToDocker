pipeline {
    agent any

    environment {
        GIT_CREDENTIAL_ID = 'github_user_pwd'
        GIT_REPO = 'https://github.com/StackOps-bridge/applied-devops.git'
        GIT_BRANCH = 'develop'

        IMAGE_NAME = 'user-api'
        VERSION = "1.0.${BUILD_NUMBER}"
        CONTAINER_NAME = 'user-api'

        MONGO_CONTAINER = 'mongo'
        MONGO_IMAGE = 'mongo:6'
        MONGO_PORT = '27017'
        MONGO_USER = 'sa'
        MONGO_PASS = 'password'
        MONGO_DB = 'stackOps_database'
    }

    stages {
        stage('Check out source code') {
            steps{
                echo "start check out code from ${GIT_REPO}"
                git credentialsId: "${GIT_CREDENTIAL_ID}", url:"${GIT_REPO}", branch:"${GIT_BRANCH}"
                echo "check out done"
            }    
        }

        stage('Start MongoDB if not running') {
            steps {
                script {
                    def mongoRunning = bat(script: '@echo off && docker ps -q -f name=%MONGO_CONTAINER%', returnStdout: true).trim()
                    def mongoExists = bat(script: '@echo off && docker ps -a -q -f name=%MONGO_CONTAINER%', returnStdout: true).trim()

                    if (!mongoRunning && !mongoExists) {
                        echo "MongoDB container not found. Creating and starting MongoDB container..."
                        bat """
                            docker run -d --name %MONGO_CONTAINER% ^
                                -e MONGO_INITDB_ROOT_USERNAME=%MONGO_USER% ^
                                -e MONGO_INITDB_ROOT_PASSWORD=%MONGO_PASS% ^
                                -p %MONGO_PORT%:27017 %MONGO_IMAGE%
                        """
                    } else if (!mongoRunning && mongoExists) {
                        echo "MongoDB container exists but not running. Starting it..."
                        bat "docker start %MONGO_CONTAINER%"
                    } else {
                        echo "MongoDB container is already running."
                    }
                }
            }
        }

        stage('Build Spring Boot JAR') {
            steps {
                dir('userAPI') {
                    bat 'gradlew clean build'
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                dir('userAPI') {
                    bat 'docker build -t %IMAGE_NAME%:%VERSION% .'
                }
            }
        }

        stage('Stop Old Container') {
            steps {
                script {
                    def containerId = bat(script: '@echo off && docker ps -a -q -f name=%CONTAINER_NAME%', returnStdout: true).trim()

                    if (containerId) {
                        echo "Old container found. Stopping and removing..."
                        bat "docker stop %CONTAINER_NAME% || exit 0"
                        bat "docker rm %CONTAINER_NAME% || exit 0"
                    } else {
                        echo "No old container found."
                    }
                }
            }
        }

        stage('Run userAPI Container') {
            steps {
                bat """
                    docker run -d --name %CONTAINER_NAME% ^
                        -e SPRING_DATA_MONGODB_HOST=host.docker.internal ^
                        -e SPRING_DATA_MONGODB_PORT=%MONGO_PORT% ^
                        -e SPRING_DATA_MONGODB_USERNAME=%MONGO_USER% ^
                        -e SPRING_DATA_MONGODB_PASSWORD=%MONGO_PASS% ^
                        -e SPRING_DATA_MONGODB_DATABASE=%MONGO_DB% ^
                        -p 9061:8080 %IMAGE_NAME%:%VERSION%
                """
            }
        }
    }

    post {
        success {
            echo 'Deployment completed successfully!'
        }
        failure {
            echo 'Pipeline failed!'
        }
    }
}
