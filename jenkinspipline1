pipeline {
    agent any

    environment {
        JAVA_HOME = 'C:\\Program Files\\Java\\jdk-17'  // 根据实际路径修改
        GIT_CREDENTIALS_ID = 'github_user_pwd'
        GIT_REPO = 'https://github.com/lee-liao/NA-AIA-main.git'
        GIT_BRANCH = 'main'
        
        NGINX_HTML = 'D:\\Program Files\\nginx-1.28.0\\html\\'
        API_DIR = 'D:\\Program Files\\nginx-1.28.0\\html\\api'
        API_NAME_USER = 'userAPI'
        API_NAME_EVENT = "eventAPI"

        NEXUS_URL = 'http://localhost:8081'
        NEXUS_REPO = 'maven-snapshots'
        GROUP_ID = 'com.stackops'
        ARTIFACT_ID = 'userAPI'
        VERSION = '1.0-SNAPSHOT'
        ARTIFACT_PATH = "${GROUP_ID.replace('.', '/')}/${ARTIFACT_ID}/${VERSION}"
    }

    stages {
        
        stage('Checkout Source') {
            steps {
                git credentialsId: "${GIT_CREDENTIALS_ID}",
                    url: "${GIT_REPO}",
                    branch: "${GIT_BRANCH}"
            }
        }

        stage('Build JAR with Gradle') {
            steps {
                dir('userAPI') {
                    bat 'gradlew clean build'
                }
            }
        }

       stage('Publish userAPI jar to Nexus') {
            steps {
                dir('userAPI') {
                    withCredentials([usernamePassword(credentialsId: 'nexus_connect', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                        script {
                            try {
                                bat '''
                                      gradlew.bat publish ^
                                        -PnexusUsername=%NEXUS_USER% ^
                                        -PnexusPassword=%NEXUS_PASS% ^
                                        --stacktrace --info
                                    '''
                            } catch (err) {
                                echo "❌ Gradle publish failed!"
                                echo "Error details: ${err}"
                                currentBuild.result = 'FAILURE'
                                throw err
                            }
                        }
                    }    
                }
            }
        }

        stage('Get Latest Snapshot JAR from Nexus') {
            steps {
                dir('userAPI') {
                    withCredentials([usernamePassword(credentialsId: 'nexus_connect', usernameVariable: 'NEXUS_USER', passwordVariable: 'NEXUS_PASS')]) {
                        bat '''
                            curl -u %NEXUS_USER%:%NEXUS_PASS% -s "%NEXUS_URL%/repository/%NEXUS_REPO%/%ARTIFACT_PATH%/maven-metadata.xml" -o metadata.xml

                            for /f "tokens=*" %%i in ('powershell -command "(Select-Xml -Path metadata.xml -XPath \\"//snapshot/timestamp\\").Node.InnerText"') do set TIMESTAMP=%%i
                            for /f "tokens=*" %%i in ('powershell -command "(Select-Xml -Path metadata.xml -XPath \\"//snapshot/buildNumber\\").Node.InnerText"') do set BUILDNUMBER=%%i

                            set SNAPSHOT_JAR=%ARTIFACT_ID%-%TIMESTAMP%-%BUILDNUMBER%.jar
                            echo Latest Snapshot JAR: %SNAPSHOT_JAR%

                            curl -u %NEXUS_USER%:%NEXUS_PASS% -O "%NEXUS_URL%/repository/%NEXUS_REPO%/%ARTIFACT_PATH%/%SNAPSHOT_JAR%"
                            move /Y %SNAPSHOT_JAR% userAPI-latest.jar
                        '''
                    }
                }
            }
        }

        stage('Deploy Snapshot JAR') {
            steps {
                dir('userAPI') {
                    script {
                        // Check if folder exists, if not create it
                        def fullPath = "${API_DIR}\\${API_NAME_USER}"
                        def checkCommand = "if not exist \"${fullPath}\" mkdir \"${fullPath}\""
                        bat checkCommand
                        
                        def targetJar = "${fullPath}\\userAPI.jar"
                        bat "copy userAPI-latest.jar \"${targetJar}\""

                        // Example: run the JAR
                        bat "start /B cmd /C \"java -jar \"${targetJar}\" --server.port=9090 > \"${fullPath}\"\\userAPI.log 2>&1\""
                    }    
                }
            }
        }
        
    }

    post {
        failure {
            echo 'Pipeline failed!'
        }
        success {
            echo 'Deployment completed successfully!'
        }
    }
}
